# ─────────────────────────────────────────────────────────────────────────────
# .dockerignore — DompetIN
# Prevents unnecessary/sensitive files from being sent to the Docker build context
# ─────────────────────────────────────────────────────────────────────────────

# Git
.git
.gitignore

# Environment secrets — NEVER bake keys into the image
.env
*.env

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# SQLite database files — use Docker volumes for persistence instead
*.db
*.sqlite
*.sqlite3

# IDE and editor config
.vscode/
.idea/
*.code-workspace

# OS junk
.DS_Store
Thumbs.db

# Scratch / dev-only scripts
scratch/
check_db.py
check_indices.py
check_schema.py
fix_budget.py

# Build outputs
dist/
build/
*.egg-info/

# Test files
tests/
test_*.py
